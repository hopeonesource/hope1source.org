{
  "name": "hope1source-org",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/write-seo.mjs",
    "build": "node scripts/check-routes.mjs && vite build && node scripts/spa-fallback.mjs && node scripts/build-v3.mjs && node scripts/build-v4.mjs",
    "dev:v3": "vite --config preview-v3/vite.config.js",
    "preview": "vite preview --host",
    "check:routes": "node scripts/check-routes.mjs",
    "dev:v4": "vite --config preview-v4/vite.config.js"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/source-sans-3": "^5.2.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "vite": "^7.1.5"
  }
}
